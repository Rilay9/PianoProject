<!--
  E1's bridge fixture: five printed bars, a one-beat pickup (bar 1) and a repeat over bars 2-3,
  so the unrolled measures (1 2 3 2 3 4 5) are not the printed ones. Read by
  app/tests/unit/demandsOfFiles.test.ts (the positions the bridge writes, per printed bar) and by
  tools/content/tests/test_excerpts.py (the cutter keeps the pickup and refuses a crossing).
  Right hand: G4 | C5 E5 D5 B4 | C5 (half) G4 (half) | E4 F4 G4 A4 (eighths) B4 (half) | C5 (whole)
  Left hand:  rest | C3 (whole) | G2 (whole) | C3 (half) G2 (half) | C3 (whole)
-->
<score-partwise version="4.0">
  <work><work-title>Pickup and repeat</work-title></work>
  <part-list>
