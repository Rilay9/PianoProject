<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  E1's every-bar fixture: three bars of 4/4 under a right hand of whole notes. The left hand walks
  in quarters in bars 1 and 3 (C3 D3 E3 F3; G2 A2 B2 C3) and holds a whole G2 in bar 2, so the
  whole piece has no walking bass (the detector asks for every bar) and bars 1 and 3 each do.
  Read by app/tests/unit/demandsOfFiles.test.ts (the every-bar detectors read bar by bar).
-->
<score-partwise version="4.0">
  <work><work-title>Walk in two bars</work-title></work>
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
