{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pianopath/vocabulary/skills.schema.json",
  "title": "Vocabulary v0: skills",
  "description": "The reading skills (C2). The shape only: validate.py checks the references (every opportunity a demand id, every condition declared) and app/tests/unit/vocabulary.test.ts checks the ids against concepts.json.",
  "type": "object",
  "required": ["conditions", "skills"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "array", "items": { "type": "string" } },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "meaning", "recordedBy"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["keep-tempo", "unseen", "guide-off", "both-hands"] },
          "meaning": { "type": "string", "minLength": 10 },
          "recordedBy": {
            "type": ["string", "null"],
            "description": "What records whether a run met it, or null where nothing does: a standard naming an unrecorded condition is one no run can be shown to meet, and the build gate refuses a rung that requires it."
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display", "sentence", "kind", "opportunity", "observable", "standards"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "newId": { "type": "boolean", "description": "True where no concept id named the ability, so v0 added one (reviewer decision 2)." },
          "display": { "type": "string", "minLength": 2 },
          "sentence": { "type": "string", "minLength": 20 },
          "kind": { "enum": ["reading", "rhythm", "coordination", "technique", "continuity"] },
          "opportunity": {
            "oneOf": [
              { "const": "every-step" },
              { "type": "array", "minItems": 1, "items": { "type": "string" } }
            ]
          },
          "observable": {
            "oneOf": [
              { "const": "none" },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["pitch", "timing"] } }
            ]
          },
          "unobserved": { "type": "array", "items": { "type": "string", "minLength": 20 } },
          "standards": {
            "type": "object",
            "required": ["practice", "full"],
            "additionalProperties": false,
            "properties": {
              "practice": { "type": "array", "items": { "type": "string" } },
              "full": { "type": "array", "items": { "type": "string" } }
            }
          },
          "note": { "type": "string" }
        },
        "if": { "properties": { "observable": { "const": "none" } } },
        "then": { "required": ["unobserved"] }
      }
    }
  }
}
