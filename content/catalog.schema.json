{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pianopath/catalog.schema.json",
  "title": "PianoPath content catalog",
  "type": "array",
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "level",
        "levelSource",
        "hands",
        "tracks",
        "concepts",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(song|exercise|drill)\\.[a-z0-9.-]+$"
        },
        "type": {
          "enum": [
            "song",
            "exercise",
            "drill"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "composer": {
          "type": [
            "string",
            "null"
          ]
        },
        "arranger": {
          "type": [
            "string",
            "null"
          ]
        },
        "genre": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "description": "Track ids. Not an enum: content/curriculum/00-tracks.json is the one source of truth and validate.py checks every id against it (replan §1.8). The enum that used to live here drifted twice — it was missing rock-metal, jam and beautiful when P10 added a Chopin prelude to the Beautiful-pieces module.",
          "items": {
            "type": "string"
          }
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 9.99,
          "description": "stage.unit difficulty, e.g. 3.4"
        },
        "levelSource": {
          "enum": [
            "judged",
            "estimated"
          ],
          "description": "Whether `level` was decided for this piece or estimated — a whole opus banded to one number on import, or computed from features. The app prints an estimate as '≈ L7.1' and offers Re-level (replan §1.4)."
        },
        "compositionStatus": {
          "enum": [
            "pd",
            "unknown",
            "in-copyright"
          ],
          "description": "Whether the *composition* is public domain, as distinct from the edition's licence in `source.license` (`00` D23). A transcription may be CC0 while the song it transcribes is not. `unknown` is the honest answer for most of PDMX: the dataset says the upload is public domain and says nothing about the work. Items that are not `pd` are tagged `personal-build` and are placeholders in a strict-licence build."
        },
        "abrsmGradeApprox": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetSkills": {
          "type": "array",
          "description": "What the item is chosen to train: skill ids from vocabulary v0 (content/curriculum/vocabulary/skills.json), the primary first. Declared, never evidence: a run is evidence of a skill only through a measurement (design 2026-09-26 §4). validate.py refuses an id the vocabulary lacks. C2 fills it on the nine sight-reading rows only; D writes it per generator family.",
          "items": {
            "type": "string"
          }
        },
        "demands": {
          "type": "array",
          "description": "The material demands the build measured on the item's file with the app's own detectors (app/src/demands/detect.ts): demand ids from content/curriculum/vocabulary/demands.json. Measured, never declared. Absent on a runtime drill, whose demands belong to each phrase it generates. Nothing writes it yet (E).",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "enum": [
            "canonical",
            "variable",
            "transfer"
          ],
          "description": "Relative to the primary target skill (design 2026-09-26 §7): the same notes every time, a new realisation of the same constraints, or a different surface for the same skill. Nothing writes it yet (D)."
        },
        "hands": {
          "enum": [
            "both",
            "right",
            "left"
          ]
        },
        "durationSec": {
          "type": [
            "number",
            "null"
          ]
        },
        "tempoBpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "notation": {
          "type": "object",
          "description": "What the score file actually says, read from the MusicXML at build time by build.py's attach_notation and never from a title. Absent where the file could not be parsed. This exists because every other field describing a piece is asserted rather than measured - level is a constant or a regression, tracks came from the import bucket, genre from the id prefix - so choosing a song for a rung, or writing a sentence about one, had nothing but a name to go on.",
          "additionalProperties": false,
          "properties": {
            "bars": {
              "type": "integer",
              "description": "Counted inside one part. Counting across the document multiplies by the number of parts."
            },
            "staves": {
              "type": "integer"
            },
            "keys": {
              "type": "array",
              "description": "Every key signature the score carries, in order. Two entries means it changes key.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fifths": {
                    "type": "integer"
                  },
                  "mode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "fifths"
                ]
              }
            },
            "times": {
              "type": "array",
              "description": "Every time signature, as written, e.g. \"3/4\". A waltz says so here and nowhere else.",
              "items": {
                "type": "string"
              }
            },
            "chordCount": {
              "type": "integer",
              "description": "How many chord symbols are printed. Zero means a rung about chord symbols cannot use this piece to teach them."
            },
            "chords": {
              "type": "array",
              "description": "The distinct chord symbols, capped at 24. This is what says whether a piece is I-IV-V or ii-V-I with sevenths.",
              "items": {
                "type": "string"
              }
            },
            "swungMark": {
              "type": "boolean",
              "description": "Whether a direction in the score says swing or shuffle."
            },
            "finalBass": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Pitch class (0-11, C=0) of the lowest note in the final measure. A fact about the file, not a claim about the key - but since <mode> is absent from 705 of 792 songs, a key signature alone cannot tell A minor from C major, and this is what distinguishes them. requires.mode stays strict and believes only an explicit tag; candidates.py uses this to widen a search. Null where the last measure has no pitched note."
            }
          },
          "required": [
            "bars",
            "staves",
            "keys",
            "times",
            "chordCount",
            "chords",
            "swungMark"
          ]
        },
        "keySig": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeSig": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^\\s]+\\.(mxl|musicxml|xml|pdf)$",
          "description": "path under content/ to .mxl/.musicxml, or to a .pdf that opens in the page viewer (04 §5b) rather than the Score screen; null for IMPORT or runtime-generated drills"
        },
        "variantOf": {
          "type": [
            "string",
            "null"
          ],
          "description": "id of the parent song when this is simple/full/easy edition"
        },
        "variantLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "drill": {
          "type": [
            "object",
            "null"
          ],
          "description": "for type=drill: runtime generator spec",
          "properties": {
            "kind": {
              "enum": [
                "scale",
                "arpeggio",
                "chord",
                "inversion",
                "hanon",
                "five-finger",
                "rhythm",
                "sight-reading",
                "ear-interval",
                "ear-chord",
                "ear-progression",
                "note-flash",
                "find-key",
                "pedal",
                "dynamics",
                "backing-track",
                "call-response",
                "coordination",
                "cadence",
                "accompaniment",
                "interval-reading",
                "position-shift",
                "double-third",
                "double-sixth",
                "octave-scale",
                "broken-octaves",
                "broken-seventh",
                "repeated-notes",
                "trill",
                "tremolo",
                "rotation",
                "articulation",
                "hand-independence",
                "shaping",
                "voicing",
                "syncopation",
                "meter",
                "pedal-held",
                "half-pedal",
                "seventh-voicing",
                "ii-V-I",
                "tritone-sub",
                "progression",
                "slash-bass",
                "walking-bass",
                "comping",
                "stride",
                "turnaround",
                "open-voicing",
                "boogie",
                "blues-scale",
                "clave",
                "tumbao",
                "montuno",
                "latin-groove",
                "mode",
                "chord-scale",
                "extended-chord",
                "harmonic-dictation",
                "transposition",
                "roman-numeral",
                "ear-tune",
            "checklist",
            "placement",
            "walkthrough",
            "simon"
              ],
              "description": "on a type=drill item this selects the runtime screen; on a type=exercise item it records what generated the notation and needs no screen (docs/05 §7)"
            },
            "params": {
              "type": "object",
              "properties": {
                "help": {
                  "enum": [
                    "show-keys",
                    "keys-after-miss",
                    "ear-only"
                  ],
                  "description": "kind: simon only (docs/04 §5c-2) — which rung of the help ladder the item opens on: keys lit and named as the chain plays, keys lit on a replay after a wrong note, or sound alone. The learner switches it on the card and the choice is then remembered per item."
                }
              }
            }
          },
          "required": [
            "kind"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "name",
            "license",
            "pd_region"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "license": {
              "type": "string"
            },
            "pd_region": {
              "enum": [
                "worldwide",
                "US"
              ]
            },
            "fetchedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "checksum": {
              "type": [
                "string",
                "null"
              ]
            },
            "editionNotes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "importHint": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "type": "array",
          "description": "ids of other catalog items that train the same thing — what the app offers for \"swap this\", and what an import-only item points at so it is never a dead row (docs/00 D21, docs/04 §2). Every id must resolve; validate.py checks it.",
          "items": {
            "type": "string"
          }
        },
        "teaching": {
          "type": "object",
          "properties": {
            "lessonIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            },
            "practiceTips": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sections": {
              "type": "array",
              "description": "named practice sections (bar ranges) for the loop feature",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "fromMeasure",
                  "toMeasure"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "fromMeasure": {
                    "type": "integer"
                  },
                  "toMeasure": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "label",
              "url"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "video",
                  "article",
                  "pdf",
                  "audio"
                ]
              },
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "teacher": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
