{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pianopath/curriculum.schema.json",
  "title": "PianoPath curriculum",
  "type": "object",
  "required": ["version", "stages", "tracks"],
  "properties": {
    "version": { "type": "integer" },
    "tracks": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "title", "description", "startsAtStage"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" }, "startsAtStage": { "type": "integer" }, "defaultActive": { "type": "boolean" } } }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "title", "summary", "units"],
        "properties": {
          "number": { "type": "integer", "minimum": 0, "maximum": 9 },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "approxDuration": { "type": "string" },
          "abrsmGradeApprox": { "type": "string" },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "track", "lessons"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9]\\.[0-9]+$|^[a-z-]+\\.[0-9]+\\.[0-9]+$" },
                "title": { "type": "string" },
                "track": { "type": "string" },
                "lessons": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "concepts", "textFile", "exerciseOptions", "songOptions", "mastery"],
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "concepts": { "type": "array", "items": { "type": "string" } },
                      "textFile": { "type": "string" },
                      "videos": { "type": "array", "items": { "type": "object", "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string" }, "teacher": { "type": "string" } } } },
                      "exerciseOptions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                      "songOptions": { "type": "array", "items": { "type": "string" } },
                      "optionsExempt": { "type": "boolean", "description": "the lesson is a single thing by nature and has no alternatives to offer \u2014 the guided tour, the placement test, the posture checklist. Exempts it from the three-alternatives rule (docs/00 D21). Orientation only; it is not a way to ship a thin practice rung, and validate.py reports how many lessons use it." },
                      "songOptional": { "type": "boolean", "description": "true when no song tests this unit\u2019s skill (reading by interval, the first scale, accompaniment patterns, the theory and improvisation tracks). The lesson then completes on two exercises, and validate.py checks the three-alternatives rule against the combined option count instead of the songs alone (docs/00 D21, docs/02 Part G)." },
                      "prerequisites": { "type": "array", "items": { "type": "string" } },
                      "mastery": {
                        "type": "object",
                        "required": ["exercisesRequired", "songsRequired", "minAccuracy", "minTempoPct"],
                        "properties": {
                          "exercisesRequired": { "type": "integer" },
                          "songsRequired": { "type": "integer" },
                          "minAccuracy": { "type": "number" },
                          "minTempoPct": { "type": "number" },
                          "custom": { "type": "string", "description": "free text for checks the engine implements specially, e.g. 'pedal-clean>=0.9'" }
                        }
                      },
                      "estimatedDays": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
