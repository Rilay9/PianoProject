{
  "name": "piano-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run check:scoring && npm run check:lab && npm run check:activity && npm run check:path && npm run check:midi && npm run check:pdf && npm run check:wake && npm run check:practice && npm run check:readability && npm run check:exercise && npm run check:flow && npm run check:content",
    "check:notes": "vite build && node tests/notes-match.mjs",
    "check:browser": "vite build && node tests/browser.mjs",
    "check:scoring": "node tests/scoring.mjs",
    "check:lab": "node tests/lab-judge.mjs",
    "check:activity": "node tests/activity.mjs",
    "check:path": "node tests/path.mjs",
    "check:content": "node tests/content.mjs",
    "check:midi": "node tests/midi.mjs",
    "check:pdf": "node tests/pdf.mjs",
    "check:readability": "node tests/readability.mjs",
    "check:wake": "node tests/wake.mjs",
    "check:practice": "node --import ./tests/ts-ext.mjs --experimental-transform-types --no-warnings tests/practice.mjs",
    "check:exercise": "node --import ./tests/ts-ext.mjs --experimental-transform-types --no-warnings tests/exercise.mjs",
    "check:flow": "node --import ./tests/ts-ext.mjs --experimental-transform-types --no-warnings tests/flow.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "jszip": "3.10.1",
    "opensheetmusicdisplay": "2.2.0",
    "pdfjs-dist": "5.4.394",
    "smplr": "1.0.0",
    "tonal": "6.4.3",
    "vexflow": "1.2.93"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
