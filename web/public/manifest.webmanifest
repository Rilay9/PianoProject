{
  "name": "Piano",
  "short_name": "Piano",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#d9dce1",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/vnd.recordare.musicxml",
            "application/vnd.recordare.musicxml+xml",
            "application/xml",
            "text/xml",
            "application/pdf",
            "audio/midi",
            "audio/x-midi",
            "application/zip",
            "application/octet-stream",
            ".musicxml",
            ".mxl",
            ".xml",
            ".pdf",
            ".mid",
            ".midi"
          ]
        }
      ]
    }
  }
}
