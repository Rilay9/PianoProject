<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  Regression tripwire for an OpenSheetMusicDisplay 2.1.2 parsing defect.

  Measure 1 holds three quarter notes and one sixteenth-note grace. OSMD reads
  SourceMeasure.Duration as a single quarter and its iterator stops after the
  first voice entry, so the last two thirds of the bar vanish from the model
  with no exception thrown. The same measure with an eighth-note grace parses
  correctly, which is why tests/fixtures/scores/edge/pickup-grace.musicxml uses
  eighth graces.

  tests/unit/scoreModelKnownIssues.test.ts asserts the broken behaviour on
  purpose: when it starts failing, OSMD has fixed the bug and the workaround
  (and this file) can go.
-->
<score-partwise version="3.1">
  <work><work-title>Grace sixteenth truncation</work-title></work>
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1">
      <attributes><divisions>6</divisions><key><fifths>0</fifths></key>
        <time><beats>3</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef></attributes>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>6</duration><voice>1</voice><type>quarter</type></note>
      <note><grace/><pitch><step>D</step><octave>5</octave></pitch><voice>1</voice><type>sixteenth</type></note>
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>6</duration><voice>1</voice><type>quarter</type></note>
      <note><pitch><step>F</step><octave>5</octave></pitch><duration>6</duration><voice>1</voice><type>quarter</type></note>
    </measure>
  </part>
</score-partwise>
