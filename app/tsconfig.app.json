{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    // "node" is declared rather than left to leak in: tests/unit is part of
    // this project and its fixture helpers read scores with node:fs, which
    // pulls @types/node's globals in anyway. Declaring it keeps setTimeout and
    // friends resolving to one known set of overloads.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests/unit"]
}
