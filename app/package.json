{
  "name": "pianopath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "content:build": "python3 ../tools/content/build.py",
    "prebuild": "npm run content:build && node scripts/generate-icons.mjs",
    "predev": "node scripts/generate-icons.mjs",
    "pwa:audit": "node scripts/pwa-audit.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "opensheetmusicdisplay": "2.1.2",
    "pdfjs-dist": "^5.4.394",
    "smplr": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
