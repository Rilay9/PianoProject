+
+function rung(id: string): Lesson {
+  for (const stage of curriculum.stages) {
+    for (const unit of stage.units) for (const one of unit.lessons) if (one.id === id) return one;
+  }
+  throw new Error(`no rung ${id}`);
+}
+
+function item(id: string): CatalogItem {
+  const row = byId.get(id);
+  if (!row) throw new Error(`no catalog row ${id}`);
+  return row;
+}
+
+function source(path: string): string {
+  return readFileSync(resolve('src', path), 'utf8').replace(/\r\n/g, '\n');
+}
+
+/** The lesson's text with its front matter, italics and line breaks gone, as the other lesson rows read it. */
+function text(): string {
+  return readFileSync(resolve('..', 'content', 'lessons', 'blues.6.md'), 'utf8')
+    .replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, '')
+    .replace(/\*/g, '')
+    .replace(/\s+/g, ' ');
+}
+
+function xmlOf(id: string): string {
+  return toMusicXml(new Uint8Array(readFileSync(join(CONTENT, item(id).file ?? ''))));
+}
+
+/** The chart's bars as the screen builds them (PH2): each bar's segments, as `[symbol text, start in quarters]`. */
+function bars(id: string): [string | null, number][][] {
+  const { symbols, measures } = readHarmony(xmlOf(id));
+  return chartSegments(symbols, measures).bars.map((bar) =>
+    bar.segments.filter((segment) => !segment.carried).map((segment) => [segment.symbol?.text ?? null, segment.start]),
+  );
+}
+
+/** Each bar's first symbol, read from the score as the chart reads it. */
+function firstSymbols(id: string): ChordSymbol[] {
+  const { symbols, measures } = readHarmony(xmlOf(id));
+  return chartSegments(symbols, measures).bars.map((bar) => bar.segments[0]?.symbol as ChordSymbol);
+}
+
+const STEPS = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
+const STEP_PC = [0, 2, 4, 5, 7, 9, 11];
+/** The notes of one staff, bar by bar, as MIDI numbers, chords as one group: a reader of the file, not of the generator. */
+function staffBars(id: string, staff: 1 | 2): number[][][] {
+  const xml = xmlOf(id);
+  const out: number[][][] = [];
+  for (const measure of xml.matchAll(/<measure(?:\s[^>]*)?>([\s\S]*?)<\/measure>/g)) {
+    const groups: number[][] = [];
+    for (const note of (measure[1] as string).matchAll(/<note(?:\s[^>]*)?>([\s\S]*?)<\/note>/g)) {
+      const body = note[1] as string;
+      if (!body.includes(`<staff>${String(staff)}</staff>`) || body.includes('<rest')) continue;
+      const step = /<step>([A-G])<\/step>/.exec(body)?.[1] as string;
+      const alter = Number(/<alter>(-?\d+)<\/alter>/.exec(body)?.[1] ?? 0);
+      const octave = Number(/<octave>(-?\d+)<\/octave>/.exec(body)?.[1]);
+      const midi = 12 * (octave + 1) + (STEP_PC[STEPS.indexOf(step)] as number) + alter;
+      if (body.includes('<chord')) (groups[groups.length - 1] as number[]).push(midi);
+      else groups.push([midi]);
+    }
+    out.push(groups);
+  }
+  return out;
+}
+
+const pc = (midi: number): number => ((midi % 12) + 12) % 12;
+const third = (symbol: ChordSymbol): number => (symbol.text.includes('m') ? 3 : 4);
+
+/** The numeral a symbol stands for in a minor key on `tonic`, by its root's distance and its quality. */
+function numeral(symbol: ChordSymbol, tonic: number): string {
+  const distance = (symbol.root - tonic + 12) % 12;
+  const minor = third(symbol) === 3;
+  const names: Record<number, string> = { 0: 'i', 5: 'iv', 7: 'v', 8: '♭vi' };
+  const name = names[distance] ?? '?';
+  return `${minor ? name : name.toUpperCase().replace('♭VI', '♭VI')}7`;
+}
