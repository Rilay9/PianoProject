@@ -0,0 +1,201 @@
+// @vitest-environment node
+/**
+ * blues.6 holds A7a.3's one counted run and keeps its own meaning (A7a.3; the reviewer's rulings
+ * `docs/review/responses/a7a-drafts.md` §5 and `docs/review/responses/a7a-lanes-landing.md` §4; the chain record
+ * `docs/chains/A7a.3.yaml`, `evidence.updates`).
+ *
+ * The requirement as ruled (option b): the rung's existing one-exercise requirement stays, and a second one names
+ * `exercise.walking-bass.c.minor-blues` with `hands: both`. Requirements count independently (`rungState.ts`), so
+ * the existing one is held to the five exercises it always counted (`items`): left over every option, one run of the
+ * minor item would hold both rows and blues.6 would go green with none of its boogie or major-blues work, which the
+ * ruling forbids ("Do not let two runs of the minor item stand in for two different requirements"; "Whole-rung
+ * completion still needs both"). The F minor and B♭ minor walking items are on the page for the chain's later steps
+ * and count toward neither row; St. James Infirmary and St. Louis Blues are optional songs that count for nothing.
+ *
+ * Read from the **built** curriculum through `rungState`, the one path from stored rows to "this rung is met".
+ * Nothing here was heard.
+ */
+import { readFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { rungState } from '../../src/evidence/rungState';
+import { VOCABULARY_V0 } from '../../src/evidence/vocabulary';
+import { requirementWords } from '../../src/ui/help';
+import type { CatalogItem, Curriculum, Lesson } from '../../src/curriculum/types';
+import type { SessionRow } from '../../src/data/db';
+
+const CONTENT = join(process.cwd(), 'public', 'content');
+const curriculum = JSON.parse(readFileSync(join(CONTENT, 'curriculum.json'), 'utf8')) as Curriculum;
+const catalog = JSON.parse(readFileSync(join(CONTENT, 'catalog.json'), 'utf8')) as CatalogItem[];
+const titleOf = (id: string): string => catalog.find((row) => row.id === id)?.title ?? id;
+
+const RUNG = 'blues.6';
+const C_MINOR = 'exercise.walking-bass.c.minor-blues';
+const F_MINOR = 'exercise.walking-bass.f.minor-blues';
+const B_FLAT_MINOR = 'exercise.walking-bass.b-flat.minor-blues';
+const E_FLAT_MINOR = 'exercise.walking-bass.e-flat.minor-blues';
+const ST_JAMES = 'song.blues.st-james-infirmary';
+const ST_LOUIS = 'song.classical.st-louis-blues.pdmx';
+/** blues.6's exercises before A7a.3, in their order: what its one-exercise requirement always counted. */
+const OLD_EXERCISES = [
+  'exercise.boogie.c.pinetop',
+  'exercise.boogie.f.walking-eighths',
+  'exercise.walking-bass.c.blues',
+  'exercise.turnaround.c.i-vi-ii-v',
+  'exercise.boogie.c.root-fifth',
+];
+const OLD_SONGS = [
+  'song.pop.boogie-easy-for-beginners.pdmx',
+  'song.pop.louisf365-boogie-woogie-and-blues-piano-exersices.pdmx',
+  'song.folk.boogie-woogie.pdmx',
+];
+const TODAY = new Date('2026-10-10T12:00:00Z');
+const BOTH = { played: 'both' as const, appPlayed: 'none' as const };
+/** What a Duet run records: the learner's one hand, the app playing the other. */
+const DUET_LEFT = { played: 'L' as const, appPlayed: 'other hand' as const };
+
+function find(where: Curriculum, id: string): Lesson | undefined {
+  for (const stage of where.stages) {
+    for (const unit of stage.units) for (const one of unit.lessons) if (one.id === id) return one;
+  }
+  return undefined;
+}
+
+/** A passing Keep tempo run of a written exercise, whole, both hands, judged by blues.6. */
+function run(itemId: string, over: Partial<SessionRow> = {}): SessionRow {
+  return {
+    itemId,
+    mode: 'tempo',
+    tempoPct: 100,
+    tempoMeasured: true,
+    accuracy: 0.95,
+    accuracyEstimated: false,
+    wrongNotes: 0,
+    missed: 0,
+    durationMs: 60_000,
+    at: '2026-10-01T10:05:00.000Z',
+    lessonId: RUNG,
+    wholeItem: true,
+    hands: BOTH,
+    ...over,
+  };
+}
+
+function reading(rows: SessionRow[]) {
+  return rungState(rows, curriculum, VOCABULARY_V0, TODAY).byRung.get(RUNG);
+}
+
+/** [the old requirement holds, the named minor requirement holds, the rung's status]. */
+function state(rows: SessionRow[]): [unknown, unknown, string | undefined] {
+  const r = reading(rows);
+  return [r?.requirements[0]?.holds, r?.requirements[1]?.holds, r?.status];
+}
+
+describe('blues.6 as the build wrote it (A7a.3)', () => {
+  it('lists the three minor walking items after its five exercises, and St. James Infirmary and St. Louis Blues after its songs', () => {
+    const rung = find(curriculum, RUNG);
+    expect(rung, 'blues.6 is not in the built curriculum').toBeDefined();
+    expect(rung?.exerciseOptions).toEqual([...OLD_EXERCISES, C_MINOR, F_MINOR, B_FLAT_MINOR]);
+    // The E♭ minor item stays in the family and off this rung (a7a-lanes-landing.md §6).
+    expect(rung?.exerciseOptions).not.toContain(E_FLAT_MINOR);
+    expect(rung?.songOptions).toEqual([...OLD_SONGS, ST_JAMES, ST_LOUIS]);
+    expect(rung?.songOptional).toBe(true);
+  });
+
+  it('keeps its one-exercise requirement over its five exercises and adds one naming the C minor item, both hands', () => {
+    expect(find(curriculum, RUNG)?.requirements).toEqual([
+      { kind: 'runs', from: 'exercises', items: OLD_EXERCISES, count: 1 },
+      { kind: 'runs', from: 'exercises', items: [C_MINOR], count: 1, hands: 'both' },
+    ]);
+  });
+
+  it('leaves St. James Infirmary on blues.3 and St. Louis Blues on blues.3 and blues.4, where they were', () => {
+    expect(find(curriculum, 'blues.3')?.songOptions).toEqual(expect.arrayContaining([ST_JAMES, ST_LOUIS]));
+    expect(find(curriculum, 'blues.4')?.songOptions).toContain(ST_LOUIS);
+  });
+
+  it('stage-6.json writes the same blues.6 options and requirements the build carries', () => {
+    const authored = JSON.parse(readFileSync(resolve('..', 'content', 'curriculum', 'stage-6.json'), 'utf8')) as Curriculum;
+    const written = find(authored, RUNG);
+    const built = find(curriculum, RUNG);
+    expect(written?.requirements).toEqual(built?.requirements);
+    expect(written?.exerciseOptions).toEqual(built?.exerciseOptions);
+    expect(written?.songOptions).toEqual(built?.songOptions);
+  });
+});
+
+describe('what meets blues.6 (A7a.3)', () => {
+  it('nothing meets nothing', () => {
+    expect(state([])).toEqual([false, false, 'not started']);
+  });
+
+  it('a both-hands run of the C minor item holds the named row and leaves the old one unheld: the rung is not met', () => {
+    expect(state([run(C_MINOR)])).toEqual([false, true, 'in progress']);
+  });
+
+  it('the C minor item and any one of the five old exercises meet it', () => {
+    for (const old of OLD_EXERCISES) {
+      expect(state([run(C_MINOR), run(old, { at: '2026-10-01T11:00:00.000Z' })])).toEqual([true, true, 'met']);
+    }
+  });
+
+  it('an old exercise alone holds the old row only', () => {
+    expect(state([run('exercise.boogie.c.pinetop')])).toEqual([true, false, 'in progress']);
+  });
+
+  it('a run of the C minor item with one hand, right or left, or a Duet run, does not hold the named row', () => {
+    const pinetop = run('exercise.boogie.c.pinetop', { at: '2026-10-01T11:00:00.000Z' });
+    for (const hands of [
+      { played: 'R' as const, appPlayed: 'none' as const },
+      { played: 'L' as const, appPlayed: 'none' as const },
+      DUET_LEFT,
+    ]) {
+      expect(state([run(C_MINOR, { hands }), pinetop])).toEqual([true, false, 'in progress']);
+    }
+    // A row with no recorded hands cannot prove both.
+    const { hands: _dropped, ...noHands } = run(C_MINOR);
+    expect(state([noHands as SessionRow, pinetop])).toEqual([true, false, 'in progress']);
+  });
+
+  it('the F minor and B♭ minor items count toward neither row; nor does the major walking item toward the minor one', () => {
+    expect(state([run(F_MINOR), run(B_FLAT_MINOR, { at: '2026-10-01T11:00:00.000Z' })])).toEqual([false, false, 'in progress']);
+    expect(state([run('exercise.walking-bass.c.blues')])).toEqual([true, false, 'in progress']);
+  });
+
+  it('a run of St. James Infirmary or St. Louis Blues counts for nothing here', () => {
+    expect(state([run(ST_JAMES), run(ST_LOUIS, { at: '2026-10-01T11:00:00.000Z' })])).toEqual([false, false, 'in progress']);
+  });
+
+  it('a C minor run judged by another rung, in Wait for me, or below the tempo does not count', () => {
+    const pinetop = run('exercise.boogie.c.pinetop', { at: '2026-10-01T11:00:00.000Z' });
+    expect(state([run(C_MINOR, { lessonId: 'blues.5' }), pinetop])).toEqual([true, false, 'in progress']);
+    expect(state([run(C_MINOR, { mode: 'wait', tempoMeasured: false }), pinetop])).toEqual([true, false, 'in progress']);
+    expect(state([run(C_MINOR, { tempoPct: 80 }), pinetop])).toEqual([true, false, 'in progress']);
+  });
+});
+
+describe('what the page says the rung counts (A7a.3; the both-hands line HB1 left to this placement)', () => {
+  const rung = find(curriculum, RUNG) as Lesson;
+  const context = {
+    accuracy: 0.9,
+    tempoPct: 85,
+    titleOf,
