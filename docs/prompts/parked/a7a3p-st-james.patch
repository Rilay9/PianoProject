@@ -0,0 +1,102 @@
+/**
+ * blues.6's minor-blues placement as a learner meets it (A7a.3, lane A7a3P; the chain record `docs/chains/A7a.3.yaml`;
+ * the reviewer's `docs/review/responses/a7a-lanes-landing.md` §4, §8 and §9).
+ *
+ * 1. The page: the three minor walking items among eight exercises, St. James Infirmary and St. Louis Blues among five
+ *    songs, and *What the app counts* listing two requirements, the second naming the C minor item and saying that a
+ *    one-hand run does not count (the both-hands line HB1 left to this placement).
+ * 2. The last task's door (step 14, `A7a3-static-chart-feedback`): the B♭ minor item's chart from its row, not running,
+ *    *Comp* and *Bass + drums* off, thirteen cells; with no *Count off ▶* the bar stays at 1, and a chord held for bar
+ *    5 (E♭m7) is judged in bar 1's cell against B♭m7, while bar 5's own cell never answers. That is why the lesson says
+ *    to ignore the cell.
+ * 3. St. James Infirmary's chart from its row (steps 9-12, after PH2): 24 cells, not 41, and bar 1 drawn as its three
+ *    chords at their starts.
+ *
+ * Reads the built content (run the content build first). Nothing heard: the screen's facts, not a judgement of the music.
+ */
+import { expect, test, type Page } from '@playwright/test';
+import { installMidiMock } from './fixtures/midiMock';
+
+const RUNG = 'blues.6';
+const C_MINOR = 'exercise.walking-bass.c.minor-blues';
+const B_FLAT_MINOR = 'exercise.walking-bass.b-flat.minor-blues';
+const ST_JAMES = 'song.blues.st-james-infirmary';
+
+test.beforeEach(async ({ page }) => {
+  await page.addInitScript(() => {
+    if (sessionStorage.getItem('e2e-fresh') === null) {
+      sessionStorage.setItem('e2e-fresh', '1');
+      indexedDB.deleteDatabase('pianopath');
+      localStorage.clear();
+      localStorage.setItem('pianopath.setup', JSON.stringify({ status: 'skipped', at: '2026-09-09T00:00:00.000Z', version: 1 }));
+      localStorage.setItem('pianopath.firstSight', '["*"]');
+    }
+  });
+});
+
+async function openChartFromRow(page: Page, list: '#lesson-exercises' | '#lesson-songs', id: string, title: string): Promise<void> {
+  await page.goto(`/#/lesson/${RUNG}`);
+  const row = page.locator(`${list} .list-row[data-item="${id}"]`);
+  await expect(row).toBeVisible({ timeout: 15_000 });
+  await row.getByRole('button', { name: `Open the chord chart for ${title}`, exact: true }).click();
+  await expect(page.locator('section[data-screen="chart"]')).toBeVisible({ timeout: 60_000 });
+  expect(new URL(page.url()).hash).toContain(encodeURIComponent(id));
+  await expect(page.locator('#chart-start')).toBeVisible({ timeout: 30_000 });
+}
+
+test('blues.6: the minor items and the two songs are on the page, and what counts names the C minor item with both hands', async ({ page }) => {
+  test.setTimeout(90_000);
+  await page.goto(`/#/lesson/${RUNG}`);
+  await expect(page.locator('#lesson-exercises .list-row')).toHaveCount(8, { timeout: 15_000 });
+  await expect(page.locator('#lesson-songs .list-row')).toHaveCount(5);
+  for (const id of [C_MINOR, 'exercise.walking-bass.f.minor-blues', B_FLAT_MINOR]) {
+    await expect(page.locator(`#lesson-exercises .list-row[data-item="${id}"]`)).toBeVisible();
+  }
+  for (const id of [ST_JAMES, 'song.classical.st-louis-blues.pdmx']) {
+    await expect(page.locator(`#lesson-songs .list-row[data-item="${id}"]`)).toBeVisible();
+  }
+  await expect(page.getByText('Bars 9 and 10 have more than one version.', { exact: false })).toBeVisible();
+  const summary = page.locator('#lesson-counts summary');
+  await expect(summary).toBeVisible({ timeout: 15_000 });
+  expect(((await summary.textContent()) ?? '').replace(/\s+/g, ' ').trim()).toBe('What the app counts — 0 of 2');
+  const lines = await page.locator('#lesson-counts li').evaluateAll((items) => items.map((li) => (li.textContent ?? '').replace(/\s+/g, ' ').trim()));
+  expect(lines).toHaveLength(2);
+  expect(lines[0]).toContain('One of Boogie — pinetop in C, both hands; ');
+  expect(lines[1]).toContain(
+    'Walking bass over a minor 12-bar blues in C minor at 90 % of the notes, in Keep tempo at 85 % of the written tempo or faster, played with both hands: a run of one hand, Duet included, does not count.',
+  );
+  await page.locator('#lesson-counts summary').click();
+  await page.locator('#lesson-counts').screenshot({ path: test.info().outputPath('counts.png') });
+});
+
+test('blues.6: the B♭ minor chart, never started, stays on bar 1 and judges a bar-5 chord against bar 1', async ({ page }) => {
+  test.setTimeout(120_000);
+  const midi = await installMidiMock(page, { permission: 'granted' });
+  await openChartFromRow(page, '#lesson-exercises', B_FLAT_MINOR, 'Walking bass over a minor 12-bar blues in B♭ minor');
+  const chart = page.locator('section[data-screen="chart"]');
+  await expect(chart).not.toHaveAttribute('data-running', 'true');
+  await expect(page.locator('#chart-comp')).toHaveAttribute('aria-pressed', 'false');
+  await expect(page.locator('#chart-backing')).toHaveAttribute('aria-pressed', 'false');
+  const cells = page.locator('.chart-cell');
+  await expect(cells).toHaveCount(13);
+  await expect(page.locator('#chart-form')).toHaveText('Bar 1 of 13 · chorus 1');
+  // Bar 5's chord, E♭m7 as E♭, G♭ and D♭, held with nothing pressed: judged in bar 1's cell, against B♭m7.
+  for (const pitch of [63, 66, 73]) await midi.noteOn(pitch, 90);
+  await expect(cells.nth(0)).toHaveAttribute('data-match', 'no', { timeout: 10_000 });
+  expect(await cells.nth(4).getAttribute('data-match')).toBeNull();
+  await page.screenshot({ path: test.info().outputPath('b-flat-minor-static.png') });
+  for (const pitch of [63, 66, 73]) await midi.noteOff(pitch);
+  // Bar 1's own chord reads yes there; the bar has not moved.
+  for (const pitch of [58, 61, 68]) await midi.noteOn(pitch, 90);
+  await expect(cells.nth(0)).toHaveAttribute('data-match', 'yes', { timeout: 10_000 });
+  await expect(page.locator('#chart-form')).toHaveText('Bar 1 of 13 · chorus 1');
+});
+
+test('blues.6: St. James Infirmary opens as a chart of 24 bars from its row, bar 1 holding its three chords', async ({ page }) => {
+  test.setTimeout(120_000);
+  await openChartFromRow(page, '#lesson-songs', ST_JAMES, 'St. James Infirmary');
+  await expect(page.locator('.chart-cell')).toHaveCount(24);
+  const first = page.locator('.chart-cell[data-bar="1"] .chart-seg');
+  await expect(first).toHaveCount(3);
+  await page.screenshot({ path: test.info().outputPath('st-james-chart.png') });
+});
