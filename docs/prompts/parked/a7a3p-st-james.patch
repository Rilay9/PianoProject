+describe('a chart that was never started judges bar 1 only (A7a.3 step 14)', () => {
+  const BUILT = join(process.cwd(), 'public', 'content', 'scores', 'generated', 'exercise.walking-bass.b-flat.minor-blues.mxl');
+  /** B♭m7's root, third and seventh (B♭ D♭ A♭), and E♭m7's (E♭ G♭ D♭), the shells the item's right hand writes. */
+  const B_FLAT_MINOR_SHELL = [58, 61, 68];
+  const E_FLAT_MINOR_SHELL = [63, 66, 73];
+
+  beforeEach(() => {
+    metronomeState.listeners = [];
+    keys.listeners = [];
+    playChordSpy.mockClear();
+  });
+
+  afterEach(() => {
+    document.body.replaceChildren();
+  });
+
+  function press(midis: number[], kind: 'noteOn' | 'noteOff' = 'noteOn'): void {
+    for (const midi of midis) for (const listener of [...keys.listeners]) listener({ kind, midi });
+  }
+
+  it('bar 5’s chord reads no in bar 1’s cell, bar 1’s reads yes there, and no other cell answers', async () => {
+    currentXml = toMusicXml(new Uint8Array(readFileSync(BUILT)));
+    const section = ChordChartScreen(router, 'demo');
+    document.body.replaceChildren(section);
+    await vi.waitFor(() => {
+      expect(section.querySelector('.chart-cell[data-bar="13"]')).toBeTruthy();
+    });
+    const cells = [...section.querySelectorAll<HTMLElement>('.chart-cell')];
+    expect(cells).toHaveLength(13);
+    // Nothing pressed: no metronome is listened to, so nothing can move the bar.
+    expect(metronomeState.listeners).toHaveLength(0);
+    expect(section.querySelector('#chart-form')?.textContent).toBe('Bar 1 of 13 · chorus 1');
+    // Bar 5 is E♭m7 (the iv7); held now, it is judged against bar 1's B♭m7.
+    press(E_FLAT_MINOR_SHELL);
+    expect(cells[0]?.dataset.match).toBe('no');
+    expect(cells[4]?.dataset.match).toBeUndefined();
+    press(E_FLAT_MINOR_SHELL, 'noteOff');
+    expect(cells[0]?.dataset.match).toBe('idle');
+    press(B_FLAT_MINOR_SHELL);
+    expect(cells[0]?.dataset.match).toBe('yes');
+    expect(cells.slice(1).every((cell) => cell.dataset.match === undefined)).toBe(true);
+    expect(section.querySelector('#chart-form')?.textContent).toBe('Bar 1 of 13 · chorus 1');
+    expect(playChordSpy).not.toHaveBeenCalled();
+  });
+});
