<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!-- HD2: a local excursion that the voice's whole-piece majority contradicts. In bar 1 voice 5 is the
     left hand's line, staff 2, and two of its eighths (E4, G4) are printed on staff 1 before it returns
     inside the bar: those two are cross-staff, the left hand's. In bar 2 the same voice number is the
     treble staff's line for the whole bar (eight notes; the left hand is voice 6), so the voice's
     whole-piece majority is staff 1; and its move from staff 2 to staff 1 happens only across the
     barline, which is no cross-staff evidence. -->
<score-partwise version="3.1">
  <work><work-title>Local excursion</work-title></work>
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
