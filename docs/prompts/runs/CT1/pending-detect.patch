+/**
+ * One staff's strikes in one bar, in time order: each the MIDI numbers struck at
+ * that onset (a chord is one strike).
+ */
+function strikesIn(model: ScoreModelData, staff: 1 | 2, bar: number): { onset: number; midis: number[] }[] {
+  const byOnset = new Map<number, number[]>();
+  for (const p of placed(model)) {
+    if (p.note.staff !== staff || p.note.measureIndex !== bar) continue;
+    const at = byOnset.get(p.note.onset);
+    if (at === undefined) byOnset.set(p.note.onset, [p.note.midi]);
+    else at.push(p.note.midi);
+  }
+  return [...byOnset.entries()].sort((a, b) => a[0] - b[0]).map(([onset, midis]) => ({ onset, midis }));
+}
+
+/**
+ * The two hands play one line doubled in the bar (CT1, `tools/content/figures.py`
+ * `mirrored`, which this mirrors): single notes struck at the same times all
+ * through it, and either the same pitch class at every strike (similar motion in
+ * octaves) or every move answered by the opposite move within a semitone of its
+ * size (contrary motion). A two-hand scale, Hanon or arpeggio, not a tune over a
+ * left-hand pattern. The same rhythm alone is not enough: a tune in quarters
+ * over a broken chord in quarters is a tune and a pattern.
+ */
+function mirrored(model: ScoreModelData, bar: number): boolean {
+  const upper = strikesIn(model, 1, bar);
+  const lower = strikesIn(model, 2, bar);
+  if (upper.length === 0 || upper.length !== lower.length) return false;
+  for (let i = 0; i < upper.length; i++) {
+    const u = upper[i];
+    const l = lower[i];
+    if (u === undefined || l === undefined || u.midis.length !== 1 || l.midis.length !== 1 || !same(u.onset, l.onset)) return false;
+  }
+  const hi = upper.map((s) => s.midis[0] ?? 0);
+  const lo = lower.map((s) => s.midis[0] ?? 0);
+  if (hi.every((h, i) => (((h - (lo[i] ?? 0)) % 12) + 12) % 12 === 0)) return true;
+  if (hi.length < 2) return false;
+  for (let i = 1; i < hi.length; i++) {
+    const up = (hi[i] ?? 0) - (hi[i - 1] ?? 0);
+    const down = (lo[i] ?? 0) - (lo[i - 1] ?? 0);
+    if (!(up * down < 0 && Math.abs(Math.abs(up) - Math.abs(down)) <= 1)) return false;
+  }
+  return true;
+}
