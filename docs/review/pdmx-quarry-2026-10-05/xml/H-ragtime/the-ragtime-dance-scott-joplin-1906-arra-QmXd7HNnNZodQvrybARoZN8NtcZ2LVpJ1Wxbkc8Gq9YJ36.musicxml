  <credit page="3">
    <credit-words default-x="56.6893" default-y="386.689" justify="left" valign="top" font-weight="bold" font-size="9">                 NOTICE: To get the desired effect of “Stop Time,” the pianist will please  
</credit-words>
    <credit-words underline="1">Stamp
</credit-words>
    <credit-words underline="0">  the heel of one foot heavily upon the floor at the
</credit-words>
    <credit-words>     word “Stamp.”  Do not raise the toe from the floor while stamping.</credit-words>
    </credit>
