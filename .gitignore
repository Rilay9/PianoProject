node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
# Content build output. Note the trailing `/*`: git cannot re-include a path
# inside an excluded *directory*, so excluding the children instead is what
# lets the audio/ negation below work.
app/public/content/*
# The bundled piano soundfont is a committed source asset, not pipeline output.
# tools/content/build.py only writes catalog.json/curriculum.json/schemas into
# this directory, so keeping the samples here costs the build nothing and makes
# `npm run dev` work without running the Python pipeline first.
!app/public/content/audio/
app/public/icons/
app/dev-dist/
app/dist/
app/playwright-report/
app/test-results/
# Playwright writes these relative to its cwd, which is not always app/.
playwright-report/
test-results/
app/tsconfig.tsbuildinfo
app/*.tsbuildinfo
content/scores/generated/
# Fetched sources are clones, not repository content: `fetch.py` re-creates
# them and `SOURCES.md` records what was fetched. Excluding the whole tree
# (rather than the file types) keeps a cloned source from being committed as a
# gitlink, which is what happened the first time.
content/scores/imported/*
!content/scores/imported/SOURCES.md
app/.probe/

# Playwright writes a missing snapshot as "actual" and carries on. On Windows
# that means fifteen screenshots nobody has looked at appear in `git status`
# after any e2e run, and one careless `git add -A` commits them as the
# reference. Only the CI platform's snapshots are committed (docs/06 §1).
app/tests/**/*-win32.png
app/tests/**/*-darwin.png
